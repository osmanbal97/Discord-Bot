# Copy this file to .env and fill it in: cp .env.example .env

# Discord bot token (ask the bot owner, or create your own bot at
# https://discord.com/developers/applications)
DISCORD_TOKEN=

# Optional: only needed for Spotify links. Create an app at
# https://developer.spotify.com/dashboard and copy its Client ID / Secret.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

LAVALINK_URI=http://localhost:2333
# Any random string, e.g. output of: openssl rand -hex 16
LAVALINK_PASSWORD=

# Filled in after the Google device login, see SETUP.md step 4
# PLUGINS_YOUTUBE_OAUTH_REFRESHTOKEN=
